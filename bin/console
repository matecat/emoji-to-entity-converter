#!/usr/bin/env php
<?php

declare(strict_types=1);

use Matecat\EmojiParser\Command\EmojiUpdateCommand;
use Symfony\Component\Console\Application;

set_time_limit(0);

require __DIR__.'/../vendor/autoload.php';

$app = new Application('Matecat Emoji Parser', 'v1.0');

// add commands here
$app->addCommand(new EmojiUpdateCommand());

$app->run();